# ── Gemini (FREE tier) ───────────────────────────────────────────────────────
# Pehli key — jaisa pehle tha. Isi se sab kaam chalta hai.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Backup FREE keys (optional, ₹0) ──────────────────────────────────────────
# Google ka free tier PER PROJECT hota hai. Isliye AI Studio mein ek NAYA
# project banao, uski nayi FREE key yahan daalo — pehli key ka din ka quota
# khatam hone par app apne aap doosri key par shift ho jaata hai aur jawab
# kamzor nahi padta. Ek bhi backup key na ho to behaviour bilkul purana rehta
# hai (kuch nahi tootega).
#
# Jitni chaahe utni: _2 se _9 tak. Ya ek line mein comma se GEMINI_API_KEYS.
# GEMINI_API_KEY_2=second_free_key_here
# GEMINI_API_KEY_3=third_free_key_here
# GEMINI_API_KEYS=key_one,key_two,key_three

# ── Optional switches ────────────────────────────────────────────────────────
# Model ka naam khud chunna ho to (warna engine Google ki asli list se chunta hai)
# GEMINI_MODEL=gemini-2.0-flash
# QUICK mode ka offline backup search band karna ho to 0 kar do
# RV_QUICK_BACKUP_SEARCH=1
