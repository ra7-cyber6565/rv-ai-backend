# Hard project policy: zero-cost mode stays ON unless explicitly changed.
ZERO_COST_ONLY=true

# REASONING PROVIDERS / QUOTA BACKUP
# Gemini stays primary when configured. Keep keys blank in this template so a
# copied .env starts safely instead of failing on a fake placeholder credential.
# Gemini may be used only when EVERY configured Google project/key has NO paid
# billing/spend path enabled. Code cannot reliably inspect Google billing state
# from the generative API, so primary + backup/list keys are all blocked until
# the owner explicitly confirms that condition. Never commit real key values.
GEMINI_API_KEY=
# Optional backup keys used only after the active key/project is unavailable.
# Different keys are NOT assumed free merely because they are separate projects;
# each project must independently satisfy the zero-cost rule above.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Alternative list form. Prefer one method to avoid configuration confusion.
GEMINI_API_KEYS=
GEMINI_ZERO_COST_CONFIRMED=false

# Provider-level fallback order after Gemini. Missing/unconfirmed providers are
# simply skipped. This is one logical reasoning pass: falling back does NOT eat
# another research-pass budget slot.
REASONING_FALLBACK_CHAIN=groq,openrouter,ollama
REASONING_FALLBACK_TIMEOUT_SECONDS=45

# Cross-request provider cooldown memory. If a free provider has just returned a
# hard quota/auth/model/network failure, new requests briefly skip it instead of
# paying the same latency again before falling back. Cooldowns are process-local,
# store no prompts/responses/keys and expire automatically so recovery is probed.
PROVIDER_HEALTH_DAILY_QUOTA_SECONDS=1800
PROVIDER_HEALTH_RATE_LIMIT_SECONDS=180
PROVIDER_HEALTH_AUTH_SECONDS=1800
PROVIDER_HEALTH_MODEL_SECONDS=900
PROVIDER_HEALTH_TEMPORARY_SECONDS=45

# Groq currently has a Free plan with rate limits. Because the same API surface
# also supports paid accounts, ZERO_COST_ONLY requires explicit confirmation
# before this key is used. Never set true for a billing-enabled account.
GROQ_API_KEY=
GROQ_ZERO_COST_CONFIRMED=false
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter's explicit free router/model variants are allowed in ₹0 mode. The
# runtime rejects any OPENROUTER_MODEL that is not `openrouter/free` or `:free`.
# A normal free account has its own request limits, so this is a backup, not an
# unlimited service.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Final model-level backup can be a local open-weight model through Ollama. It
# has no API quota/billing but uses local RAM/CPU and must actually be installed.
# In ZERO_COST_ONLY the URL is restricted to localhost. qwen3:4b is a practical
# small default; change only to another locally installed open model.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

# RESEARCH NETWORK BOUNDS
# Discovery endpoints are exact-host allowlisted and their decompressed API
# response bodies are capped. Full-text links additionally reject localhost,
# private/reserved IPs, unsafe ports/credentials and private redirect targets.
CONNECTOR_CONNECT_TIMEOUT=10
CONNECTOR_READ_TIMEOUT=25
CONNECTOR_RETRIES=1
CONNECTOR_MAX_RESPONSE_MB=16
ALLOW_FULLTEXT_FETCH=true
# This cap is applied to decompressed streamed bytes, not only Content-Length.
MAX_FETCH_MB=120

# CENTRAL LAPTOP STORAGE
# Recommended Windows setup: create D:\InfinityResearchAI and point this root
# there. Runtime data, ChromaDB, model downloads, caches, research memory,
# uploads/temp and archive metadata are routed below this root.
# If an explicit root is unavailable/unwritable, the app fails closed instead
# of silently filling C:.
INFINITY_DATA_ROOT=D:\InfinityResearchAI

# Legacy compatibility only. Leave blank when INFINITY_DATA_ROOT is used.
INFINITY_WORK_ROOT=

# Bounded D: workspace. These are safety limits, not automatic destructive
# cleanup triggers. Only cloud-VERIFIED files may be removed by cleanup logic.
INFINITY_MAX_LOCAL_GB=50
INFINITY_MIN_FREE_GB=5

# Long research jobs: keep concurrency deliberately small so free model/search
# quotas are not drained by parallel requests. Completed results are stored in
# separate gzip JSON files and compacted only if they exceed the per-result cap.
RESEARCH_JOB_WORKERS=1
RESEARCH_JOB_HISTORY=50
RESEARCH_JOB_RESULT_MAX_MB=8
# JSON job metadata is a single-writer store. Keep this true so a second Python
# backend worker fails closed instead of corrupting durable jobs.
RESEARCH_JOB_PROCESS_LOCK=true

# PROJECT / SESSION PRIVACY
# Public clients do NOT receive a static backend secret. POST /api/v1/session
# creates a random project namespace and an opaque X-Project-Token capability.
# The HMAC signing key is generated server-side under INFINITY_DATA_ROOT and must
# never be copied into Android, browser JS, GitHub, logs or URLs.

# SERVER-SIDE ADMIN / PRIVATE OPERATIONAL METADATA
# Optional. Leave blank to make history/project/global-job-list routes behave as
# disabled (404). If those operator endpoints are needed, set a strong random
# 24+ character token ONLY in the backend environment and send it as
# X-Infinity-Admin-Token. Never put it in Android or browser JavaScript.
INFINITY_ADMIN_TOKEN=

# CLOUD ARCHIVE
# Safe default is disabled. For the temporary Google Drive archive, install the
# open-source rclone CLI, authenticate an official Google Drive OAuth remote, and
# set CLOUD_ARCHIVE_PROVIDER=google-drive-rclone. rclone OAuth tokens stay in its
# private config; they must never be committed here or embedded in Android.
CLOUD_ARCHIVE_PROVIDER=none
GOOGLE_DRIVE_RCLONE_REMOTE=
GOOGLE_DRIVE_ARCHIVE_ROOT=InfinityResearchAI
# Encryption is fail-closed by default once Drive archive is enabled. The selected
# archive remote must be identifiable by `rclone listremotes --long` as backend
# `crypt`; otherwise archive stays not-ready and local data is retained. Set false
# only as an explicit operator choice for a plain Drive remote.
# Crypt password/salt stay only in the private rclone config; never place them here.
GOOGLE_DRIVE_ARCHIVE_REQUIRE_CRYPT=true
RCLONE_EXE=rclone
RCLONE_TIMEOUT_SECONDS=1800

# Durable cloud-archive retry queue. A cloud failure keeps the local copy and
# retries later with bounded exponential backoff. These settings never enable a
# paid provider; the provider itself must separately pass the ₹0 policy.
ARCHIVE_RETRY_BASE_SECONDS=60
ARCHIVE_RETRY_MAX_SECONDS=3600
# Manifest + retry JSON read/modify/write transactions use an OS file lock as
# well as their in-process RLock. A second backend process waits only this long;
# after the deadline the archive operation fails closed and keeps the local copy.
ARCHIVE_LEDGER_LOCK_TIMEOUT_SECONDS=5
# Network uploads run on one background worker. The in-memory queue is bounded;
# overflow is still safe because durable retry intent is written before enqueue.
ARCHIVE_BACKGROUND_QUEUE_MAX=32
# Wake only while retry rows exist; the timer schedules a bounded batch on the
# same single worker and does not call a provider itself.
ARCHIVE_RETRY_POLL_SECONDS=60
# Each archive worker gives a small bounded chance to older due retries first.
ARCHIVE_RETRY_PER_KICK=2

# Process-local ₹0 quota / abuse protection for public endpoints.
RATE_LIMIT_ENABLED=true
# Anonymous session minting uses no model call, but is still bounded so one
# address cannot create unbounded project namespaces.
RATE_SESSION_PER_HOUR=20
RATE_CHAT_PER_MINUTE=30
RATE_QUICK_AI_PER_MINUTE=12
RATE_SYNC_RESEARCH_PER_HOUR=4
RATE_RESEARCH_JOBS_PER_HOUR=6
# Status/progress/result polling shares one normalized bucket per client.
RATE_JOB_POLL_PER_MINUTE=180
RATE_UPLOADS_PER_HOUR=20
RATE_AUDIO_UPLOADS_PER_HOUR=8
# Bound unique client/path buckets so an address-churn flood cannot grow limiter
# memory forever. When full, brand-new buckets fail closed until old ones expire.
RATE_LIMIT_MAX_BUCKETS=10000
# Leave false unless the app is definitely behind a trusted reverse proxy whose
# X-Forwarded-For header cannot be spoofed directly by clients.
TRUST_PROXY_HEADERS=false

# Same-origin web UI needs no CORS entry. If a separate browser frontend is
# deployed, list its exact origins here, comma-separated. Wildcard * is rejected.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# TeraBox credentials are intentionally NOT listed here yet. Add them only after
# official developer/API access is approved AND the API/storage terms are confirmed
# zero-cost. Until then Google Drive/rclone is the optional temporary archive.